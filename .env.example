# Puerto (Render/Railway lo ponen solos)
PORT=3000

# --- Firestore (producción). Si NO defines credenciales, se usa SQLite. ---
# Id del proyecto de Firebase (Project settings → General → Project ID).
# FIREBASE_PROJECT_ID=mi-proyecto
# Cuenta de servicio en una sola línea de JSON (la opción habitual en Render/Railway):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"mi-proyecto",...}
# O, en tu compu, la ruta al archivo JSON descargado (en vez del JSON en línea):
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/absoluta/serviceAccount.json

# Carpeta de SQLite solo cuando no hay Firebase (local y pruebas)
DATA_DIR=./data

# Por defecto NO hay clase de ejemplo ni materias de muestra.
# Cada clase que cree alguien empieza vacía.
# Pon SEED=true solo si quieres una clase demo con datos de ejemplo.
# SEED=true
# Código de esa clase demo (solo se usa junto con SEED=true). Si lo omites, se genera uno.
# CLASS_CODE=DEMO01

# Límites anti-abuso por IP
# RATE_CREATE_MAX=10
# RATE_CREATE_WINDOW_MS=3600000
# RATE_JOIN_MAX=60
# RATE_JOIN_WINDOW_MS=600000
