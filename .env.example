# Puerto (Render/Railway lo ponen solos)
PORT=3000
# Carpeta donde se guarda la base de datos SQLite (útil con un volumen persistente)
DATA_DIR=./data

# Por defecto NO hay clase de ejemplo ni materias de muestra.
# Cada clase que cree alguien empieza vacía.
# Pon SEED=true solo si quieres una clase demo con datos de ejemplo.
# SEED=true
# Código de esa clase demo (solo se usa junto con SEED=true). Si lo omites, se genera uno.
# CLASS_CODE=DEMO01

# Límites anti-abuso por IP
# RATE_CREATE_MAX=10
# RATE_CREATE_WINDOW_MS=3600000
# RATE_JOIN_MAX=60
# RATE_JOIN_WINDOW_MS=600000
